# Sanity Studio CMS Configuration
SANITY_STUDIO_PROJECT_ID=your_sanity_project_id
SANITY_STUDIO_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Tokens
# Used by scripts (e.g., seed.mjs) - NEVER commit actual token
SANITY_API_WRITE_TOKEN=your_sanity_write_token
SANITY_API_READ_TOKEN=your_sanity_read_token

# Personal / Contact Info (PII)
SANITY_STUDIO_CONTACT_EMAIL=your_email@example.com
