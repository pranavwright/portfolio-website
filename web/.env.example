# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_sanity_read_token

# Contact Pipeline (Formspree)
NEXT_PUBLIC_FORMSPREE_FORM_ID=your_formspree_form_id

# Personal / Contact Info (PII)
NEXT_PUBLIC_CONTACT_EMAIL=your_email@example.com

# Site URL & SEO
# Canonical absolute site URL (no trailing slash). Used for metadataBase,
# canonical links, OpenGraph/Twitter URLs, sitemap, robots, and JSON-LD @ids.
# If unset, the build falls back to the Cloudflare Pages deploy domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Search Console verification token (the content value of the
# google-site-verification meta tag). Optional.
NEXT_PUBLIC_GOOGLE_VERIFICATION=your_google_verification_token
